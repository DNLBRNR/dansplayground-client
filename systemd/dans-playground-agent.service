[Unit]
Description=Dan's Playground Board Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/root/dans-playground

ExecStart=/usr/bin/python3 /root/dans-playground/board_agent.py

Restart=always
RestartSec=5

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
